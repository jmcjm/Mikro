{
    "name": "Mikro (Flutter, android+linux)",
    "build": {
        "dockerfile": "Dockerfile",
        "options": ["--tag", "mikro_flutter_devcontainer"],
        "args": {
            "USERNAME": "${localEnv:USER}"
        }
    },

    "containerEnv": {
        "SHELL": "/bin/zsh",
        "XDG_RUNTIME_DIR": "/run/user/1000",
        "WAYLAND_DISPLAY": "wayland-0",
        "GDK_BACKEND": "wayland",
        "PULSE_SERVER": "unix:/run/user/1000/pulse/native"
    },

    "mounts": [
        "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/${localEnv:WAYLAND_DISPLAY},target=/run/user/1000/wayland-0",
        "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/pulse/native,target=/run/user/1000/pulse/native",
        "type=bind,source=${localEnv:XDG_RUNTIME_DIR}/pipewire-0,target=/run/user/1000/pipewire-0"
    ],

    "runArgs": [
        "--userns=keep-id",
        "--device=/dev/dri",
        "--name",
        "${localWorkspaceFolderBasename}_mikro_devcontainer"
    ],

    "onCreateCommand": "bash ./.devcontainer/on-create.sh",
    "postStartCommand": "bash ./.devcontainer/post-start.sh",

    "waitFor": "onCreateCommand",

    "remoteUser": "${localEnv:USER}",

    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.defaultProfile.linux": "zsh",
                "terminal.integrated.profiles.linux": {
                    "zsh": {
                        "path": "/bin/zsh"
                    }
                }
            },
            "extensions": [
                "Dart-Code.dart-code",
                "Dart-Code.flutter"
            ]
        }
    }
}
